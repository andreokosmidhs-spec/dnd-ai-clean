MONGO_URL=mongodb://mongodb:27017
DB_NAME=dnd_ai_clean

# AI Models — set ANTHROPIC_API_KEY to use Claude (recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Legacy OpenAI key (only needed if you still use OpenAI for character creation)
# OPENAI_API_KEY=your_openai_api_key_here

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production

# Stripe — get from https://dashboard.stripe.com/apikeys (use test keys for dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_UNLIMITED=price_...

# Frontend URL (for Stripe redirect after checkout)
FRONTEND_URL=http://localhost:3000

# Scene image generation — set ONE of the following (first available is used):
# Option 1: Google Gemini 3 Pro Image (Nano Banana Pro) ~$0.134/image — Emergent typically provides this
GOOGLE_API_KEY=your_google_api_key_here
# Option 2: fal.ai Flux Schnell ~$0.003/image (cheapest)
# FAL_KEY=your_fal_key_here
# Option 3: Replicate Flux Schnell ~$0.003/image
# REPLICATE_API_TOKEN=your_replicate_token_here
